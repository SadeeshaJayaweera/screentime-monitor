<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.screentime.ui.MainViewController"
            stylesheets="@styles.css"
            prefWidth="1020.0" prefHeight="720.0"
            minWidth="880.0" minHeight="640.0">

    <!-- LEFT NAVIGATION SIDEBAR -->
    <left>
        <VBox styleClass="sidebar" prefWidth="230.0" spacing="10.0">
            <!-- App Brand Header -->
            <VBox styleClass="app-brand-container">
                <HBox alignment="CENTER_LEFT" spacing="8.0">
                    <Label text="⏱️" style="-fx-font-size: 20px;"/>
                    <Label text="ScreenTime" styleClass="app-brand"/>
                </HBox>
                <Label text="Focus &amp; Ergonomic Monitor" styleClass="app-brand-subtitle"/>
            </VBox>

            <!-- Main Navigation Tab Buttons -->
            <VBox spacing="4.0">
                <Button fx:id="btnNavToday" text="📊   Today's Overview" onAction="#showTodayTab" styleClass="nav-button, nav-button-active" maxWidth="Infinity"/>
                <Button fx:id="btnNavHistory" text="📈   Analytics &amp; History" onAction="#showHistoryTab" styleClass="nav-button" maxWidth="Infinity"/>
                <Button fx:id="btnNavAi" text="✨   AI Health Coach" onAction="#showAiTab" styleClass="nav-button" maxWidth="Infinity"/>
                <Button fx:id="btnNavSettings" text="⚙️   Preferences" onAction="#showSettingsTab" styleClass="nav-button" maxWidth="Infinity"/>
            </VBox>

            <!-- Vertical Spacer -->
            <Region VBox.vgrow="ALWAYS"/>

            <!-- Sidebar Live Status Widget -->
            <VBox styleClass="sidebar-status-card">
                <HBox alignment="CENTER_LEFT">
                    <Label text="LIVE STATUS" styleClass="card-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="v1.0" style="-fx-font-size: 10px; -fx-text-fill: #475569; -fx-font-weight: bold;"/>
                </HBox>
                <Label fx:id="sidebarStatusBadge" text="● TRACKING ACTIVE" styleClass="badge-active" maxWidth="Infinity" alignment="CENTER"/>
                <Button text="⏳ Request Extension" onAction="#onRequestExtensionClicked" styleClass="btn-primary" maxWidth="Infinity" style="-fx-font-size: 11px; -fx-padding: 8 10;"/>
            </VBox>
        </VBox>
    </left>

    <!-- CENTER CONTENT STACK -->
    <center>
        <StackPane styleClass="content-area">

            <!-- 1. TODAY OVERVIEW VIEW -->
            <VBox fx:id="todayView" spacing="18.0" visible="true">
                <!-- Header Banner -->
                <HBox alignment="CENTER_LEFT" spacing="16.0">
                    <VBox spacing="3.0">
                        <Label text="Today's Overview" styleClass="view-header"/>
                        <Label fx:id="todayDateLabel" text="Loading current date..." styleClass="view-subtitle"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="currentAppBadge" text="Active App: Loading..." styleClass="badge-active"/>
                </HBox>

                <!-- Dynamic Warning / Alert Banner -->
                <Label fx:id="warningBanner" text="⚠️ Warning: 90% of daily limit reached." styleClass="banner-warning" visible="false" managed="false" maxWidth="Infinity"/>

                <!-- Top Row: Ring Gauge & Metrics Triad Cards -->
                <HBox spacing="18.0">
                    <!-- Progress Ring Card -->
                    <VBox styleClass="card" spacing="10.0" prefWidth="290.0" alignment="CENTER">
                        <HBox alignment="CENTER_LEFT">
                            <Label text="DAILY USAGE GAUGE" styleClass="card-title"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="progressPercentLabel" text="0% Used" style="-fx-text-fill: #38bdf8; -fx-font-size: 11px; -fx-font-weight: 800;"/>
                        </HBox>
                        <StackPane fx:id="progressRingContainer" alignment="CENTER" prefHeight="175.0"/>
                        <HBox alignment="CENTER" spacing="12.0">
                            <Label fx:id="todayIdleTimeLabel" text="Idle: 0m" style="-fx-text-fill: #64748b; -fx-font-size: 12px; -fx-font-weight: 600;"/>
                        </HBox>
                    </VBox>

                    <!-- Limit & Remaining Details Card -->
                    <VBox styleClass="card" spacing="16.0" HBox.hgrow="ALWAYS">
                        <Label text="DAILY LIMIT &amp; ALLOCATION" styleClass="card-title"/>

                        <HBox spacing="28.0" alignment="CENTER_LEFT">
                            <VBox spacing="4.0">
                                <Label text="Time Remaining" styleClass="stat-sublabel"/>
                                <Label fx:id="todayRemainingTimeLabel" text="8h 00m" styleClass="stat-number"/>
                            </VBox>
                            <Separator orientation="VERTICAL" style="-fx-opacity: 0.2;"/>
                            <VBox spacing="4.0">
                                <Label text="Total Active Tracked" styleClass="stat-sublabel"/>
                                <Label fx:id="todayActiveTimeLabel" text="0h 00m" styleClass="stat-number-accent"/>
                            </VBox>
                        </HBox>

                        <ProgressBar fx:id="todayProgressBar" progress="0.0" maxWidth="Infinity" style="-fx-pref-height: 8px;"/>

                        <HBox spacing="24.0" style="-fx-padding: 4px 0 0 0;">
                            <VBox spacing="2.0">
                                <Label text="Configured Goal" style="-fx-font-size: 11px; -fx-text-fill: #64748b;"/>
                                <Label fx:id="todayLimitLabel" text="8h 00m" style="-fx-font-size: 13px; -fx-text-fill: #cbd5e1; -fx-font-weight: 700;"/>
                            </VBox>
                            <VBox spacing="2.0">
                                <Label text="Extensions Granted" style="-fx-font-size: 11px; -fx-text-fill: #64748b;"/>
                                <Label fx:id="todayExtensionsLabel" text="None (+0m)" style="-fx-font-size: 13px; -fx-text-fill: #38bdf8; -fx-font-weight: 700;"/>
                            </VBox>
                        </HBox>
                    </VBox>
                </HBox>

                <!-- Top Applications Card -->
                <VBox styleClass="card" spacing="12.0" VBox.vgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT">
                        <VBox spacing="2.0">
                            <Label text="TOP APPLICATIONS TODAY" styleClass="card-title"/>
                            <Label text="Real-time distribution of active foreground applications" style="-fx-font-size: 11px; -fx-text-fill: #64748b;"/>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="⚡ Live Sync" style="-fx-font-size: 11px; -fx-text-fill: #10b981; -fx-font-weight: bold;"/>
                    </HBox>
                    <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" VBox.vgrow="ALWAYS">
                        <VBox fx:id="topAppsContainer" spacing="8.0"/>
                    </ScrollPane>
                </VBox>

                <!-- Bottom Action Controls -->
                <HBox spacing="14.0" alignment="CENTER_RIGHT">
                    <Button fx:id="btnPauseTracking" text="⏸️ Pause Tracking" onAction="#onTogglePauseTracking" styleClass="btn-secondary"/>
                    <Button text="⏳ Request Extension..." onAction="#onRequestExtensionClicked" styleClass="btn-primary"/>
                </HBox>
            </VBox>

            <!-- 2. ANALYTICS & HISTORY VIEW -->
            <VBox fx:id="historyView" spacing="18.0" visible="false">
                <HBox alignment="CENTER_LEFT" spacing="16.0">
                    <VBox spacing="3.0">
                        <Label text="Screen Time Analytics" styleClass="view-header"/>
                        <Label text="Historical trends and daily active breakdowns from local SQLite database" styleClass="view-subtitle"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <!-- Filter Range Capsule Buttons -->
                    <HBox spacing="8.0">
                        <Button fx:id="btnRange7" text="7 Days" onAction="#onRange7Selected" styleClass="btn-filter-active"/>
                        <Button fx:id="btnRange14" text="14 Days" onAction="#onRange14Selected" styleClass="btn-filter-inactive"/>
                        <Button fx:id="btnRange30" text="30 Days" onAction="#onRange30Selected" styleClass="btn-filter-inactive"/>
                    </HBox>
                </HBox>

                <!-- Interactive BarChart Card -->
                <VBox styleClass="card" spacing="10.0" VBox.vgrow="ALWAYS">
                    <Label text="DAILY ACTIVE USAGE (HOURS)" styleClass="card-title"/>
                    <BarChart fx:id="historyBarChart" legendVisible="false" animated="false" VBox.vgrow="ALWAYS" prefHeight="260.0">
                        <xAxis>
                            <CategoryAxis side="BOTTOM" fx:id="historyCategoryAxis"/>
                        </xAxis>
                        <yAxis>
                            <NumberAxis side="LEFT" label="Active Hours" fx:id="historyNumberAxis"/>
                        </yAxis>
                    </BarChart>
                </VBox>

                <!-- Tabular Daily Summary Card -->
                <VBox styleClass="card" spacing="10.0" prefHeight="190.0">
                    <Label text="DAILY SESSION LOGS" styleClass="card-title"/>
                    <TableView fx:id="historyTableView" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colDate" text="Date" prefWidth="140.0"/>
                            <TableColumn fx:id="colActiveTime" text="Active Screen Time" prefWidth="180.0"/>
                            <TableColumn fx:id="colIdleTime" text="Idle Time" prefWidth="140.0"/>
                            <TableColumn fx:id="colTopApp" text="Top Application" prefWidth="220.0"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                    </TableView>
                </VBox>
            </VBox>

            <!-- 3. AI HEALTH COACH VIEW -->
            <VBox fx:id="aiView" spacing="18.0" visible="false">
                <HBox alignment="CENTER_LEFT" spacing="16.0">
                    <VBox spacing="3.0">
                        <Label text="AI Health &amp; Ergonomic Coach" styleClass="view-header"/>
                        <Label text="Intelligent posture, optical fatigue, and break recommendations" styleClass="view-subtitle"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="aiStatusBadge" text="✨ AI Ready" styleClass="badge-ai-model"/>
                </HBox>

                <!-- AI Assessment Hero Card -->
                <VBox styleClass="ai-hero-card" spacing="10.0">
                    <HBox alignment="CENTER_LEFT" spacing="8.0">
                        <Label text="✨" style="-fx-font-size: 16px;"/>
                        <Label text="DAILY WELLNESS ASSESSMENT" styleClass="card-title" style="-fx-text-fill: #c7d2fe;"/>
                    </HBox>
                    <Label fx:id="aiAssessmentText" text="Analyzing your screen time patterns..." wrapText="true" style="-fx-font-size: 14px; -fx-text-fill: #f8fafc; -fx-line-spacing: 4px; -fx-font-weight: 500;"/>
                </VBox>

                <!-- Identified Health Concerns Card -->
                <VBox styleClass="card" spacing="10.0">
                    <Label text="IDENTIFIED HEALTH &amp; FATIGUE CONCERNS" styleClass="card-title"/>
                    <HBox fx:id="aiConcernsContainer" spacing="10.0" alignment="CENTER_LEFT"/>
                </VBox>

                <!-- Actionable Ergonomic Tips Card -->
                <VBox styleClass="card" spacing="10.0" VBox.vgrow="ALWAYS">
                    <Label text="ACTIONABLE ERGONOMIC &amp; FOCUS RECOMMENDATIONS" styleClass="card-title"/>
                    <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" VBox.vgrow="ALWAYS">
                        <VBox fx:id="aiSuggestionsContainer" spacing="10.0"/>
                    </ScrollPane>
                </VBox>

                <!-- Action Footer -->
                <HBox spacing="14.0" alignment="CENTER_RIGHT">
                    <ProgressIndicator fx:id="aiLoadingIndicator" visible="false" prefWidth="20.0" prefHeight="20.0"/>
                    <Button text="🔄 Refresh Insights" onAction="#onRefreshAiInsights" styleClass="btn-primary"/>
                </HBox>
            </VBox>

            <!-- 4. PREFERENCES & SETTINGS VIEW -->
            <VBox fx:id="settingsView" spacing="18.0" visible="false">
                <VBox spacing="3.0">
                    <Label text="Application Preferences" styleClass="view-header"/>
                    <Label text="Customize daily limits, warning thresholds, idle timeout, and AI integration" styleClass="view-subtitle"/>
                </VBox>

                <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" VBox.vgrow="ALWAYS">
                    <VBox spacing="18.0">
                        <!-- Limits & Restrictions Card -->
                        <VBox styleClass="card" spacing="16.0">
                            <Label text="🎯 DAILY LIMITS &amp; WARNING THRESHOLDS" styleClass="card-title"/>

                            <GridPane hgap="18.0" vgap="14.0">
                                <columnConstraints>
                                    <ColumnConstraints minWidth="220.0" prefWidth="260.0"/>
                                    <ColumnConstraints hgrow="ALWAYS"/>
                                </columnConstraints>

                                <Label text="Daily Screen Time Goal (Minutes):" style="-fx-text-fill: #cbd5e1; -fx-font-size: 13px; -fx-font-weight: 600;" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                                <TextField fx:id="settingDailyLimit" promptText="480 (8 hours)" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                                <Label text="Warning Thresholds (% of limit):" style="-fx-text-fill: #cbd5e1; -fx-font-size: 13px; -fx-font-weight: 600;" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                                <TextField fx:id="settingWarningThresholds" promptText="50, 75, 90, 100" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                                <Label text="Idle Timeout Sensitivity (Seconds):" style="-fx-text-fill: #cbd5e1; -fx-font-size: 13px; -fx-font-weight: 600;" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                                <TextField fx:id="settingIdleThreshold" promptText="60" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                                <Label text="Full-Screen Hard Block Alert:" style="-fx-text-fill: #cbd5e1; -fx-font-size: 13px; -fx-font-weight: 600;" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                                <CheckBox fx:id="settingHardBlock" text="Display full-screen always-on-top modal warning when daily limit is exhausted" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                                <Label text="Max Daily Extensions Allowed:" style="-fx-text-fill: #cbd5e1; -fx-font-size: 13px; -fx-font-weight: 600;" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                                <TextField fx:id="settingMaxExtensions" promptText="3" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                                <Label text="Max Extension Time Cap (Minutes):" style="-fx-text-fill: #cbd5e1; -fx-font-size: 13px; -fx-font-weight: 600;" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                                <TextField fx:id="settingMaxExtensionMinutes" promptText="120" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

                                <Label text="Launch on System Boot:" style="-fx-text-fill: #cbd5e1; -fx-font-size: 13px; -fx-font-weight: 600;" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
                                <CheckBox fx:id="settingAutostart" text="Automatically start ScreenTime Monitor in background when logging in" GridPane.rowIndex="6" GridPane.columnIndex="1"/>
                            </GridPane>
                        </VBox>

                        <!-- AI & Cloud Settings Card -->
                        <VBox styleClass="card" spacing="16.0">
                            <Label text="✨ AI &amp; GOOGLE GEMINI INTEGRATION" styleClass="card-title"/>

                            <GridPane hgap="18.0" vgap="14.0">
                                <columnConstraints>
                                    <ColumnConstraints minWidth="220.0" prefWidth="260.0"/>
                                    <ColumnConstraints hgrow="ALWAYS"/>
                                </columnConstraints>

                                <Label text="Enable AI Health Insights:" style="-fx-text-fill: #cbd5e1; -fx-font-size: 13px; -fx-font-weight: 600;" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                                <CheckBox fx:id="settingAiEnabled" text="Synthesize daily computer habits to generate tailored posture &amp; optical advice" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                                <Label text="Google Gemini API Key:" style="-fx-text-fill: #cbd5e1; -fx-font-size: 13px; -fx-font-weight: 600;" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                                <HBox spacing="8.0" GridPane.rowIndex="1" GridPane.columnIndex="1">
                                    <PasswordField fx:id="settingApiKey" promptText="Enter Gemini API key (optional - offline rules used by default)" HBox.hgrow="ALWAYS"/>
                                    <Button fx:id="btnToggleApiKey" text="👁️" onAction="#onToggleApiKeyVisibility" styleClass="btn-secondary"/>
                                </HBox>

                                <Label text="System Tray Notifications:" style="-fx-text-fill: #cbd5e1; -fx-font-size: 13px; -fx-font-weight: 600;" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                                <CheckBox fx:id="settingNotifications" text="Enable native desktop notifications for warning milestones and break tips" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                            </GridPane>
                        </VBox>
                    </VBox>
                </ScrollPane>

                <!-- Save Action Footer -->
                <HBox spacing="18.0" alignment="CENTER_RIGHT">
                    <Label fx:id="settingsSavedLabel" text="" style="-fx-text-fill: #4ade80; -fx-font-weight: bold; -fx-font-size: 13px;"/>
                    <Button text="💾 Save Preferences" onAction="#onSaveSettings" styleClass="btn-primary"/>
                </HBox>
            </VBox>

        </StackPane>
    </center>

</BorderPane>
